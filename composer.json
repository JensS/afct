{
    "name": "jenss/afct",
    "type": "wordpress-theme",
    "description": "ClassicPress theme for African Face, Colonial Tongue.",
    "keywords": [
        "WordPress",
        "Themes"
    ],
    "homepage": "https://africanface.org",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jens Sage"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "php-parallel-lint/php-parallel-lint": "^1.4.0",
        "wp-cli/i18n-command": "^2.7.0",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:wpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "lint:php": "bash scripts/lint-php.sh"
    },
    "support": {
        "issues": "https://github.com/JensS/afct/issues",
        "source": "https://github.com/JensS/afct"
    }
}
